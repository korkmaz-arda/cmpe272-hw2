# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Required — the application will refuse to start if any of these are missing.
# ---------------------------------------------------------------------------

# Fine-grained personal access token, scoped to the single repository below,
# with permissions: "Issues: Read and write" (+ the "Metadata: Read-only"
# that GitHub adds automatically). Never commit the real value.
GITHUB_TOKEN=github_pat_replace_me

# The owner (user or organization) of the repository to wrap.
GITHUB_OWNER=your-github-username

# The repository name to wrap (just the name, not owner/name).
GITHUB_REPO=your-test-repo

# Shared secret configured on the GitHub webhook. Generate your own, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace_me_with_a_random_secret

# TCP port the service listens on.
PORT=8000

# ---------------------------------------------------------------------------
# Optional — shown with their defaults.
# ---------------------------------------------------------------------------

# Where the SQLite webhook-delivery database lives.
# In Docker this is set to /data/webhooks.db and backed by a mounted volume.
DB_PATH=./data/webhooks.db

# Root log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
